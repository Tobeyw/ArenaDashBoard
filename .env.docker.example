# Copy to .env.production. Never commit real credentials.
DATABASE_URL=postgresql://dashboard_reader:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/privy_spoon_predict_production
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY
DATA_SOURCE_LABEL="生产数据库"
EXCLUDED_USER_IDS=
# Host-side port binding. Application has no authentication.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=4310
# If PG is on the Docker host, use host.docker.internal (not 127.0.0.1).
# PG must allow connections from the container network using a read-only role.
